{
  "expo": {
    "name": "NutriFlow",
    "slug": "NutriFlow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.nutriFlow",
      "appleTeamId": "CFTJPS6ZYY"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nutriFlow"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow NutriFlow to access your step count to show your daily activity."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow NutriFlow to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow NutriFlow to use speech recognition for voice search."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": false
    }
  }
}
