{
  "expo": {
    "name": "NutriFlow",
    "slug": "nutriflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nutriFlow",
      "appleTeamId": "CFTJPS6ZYY",
      "buildNumber": "2",
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "NSPhotoLibraryUsageDescription": "NutriFlow uses your photo library so you can set a profile photo, attach lab result images for AI analysis, and add photos to your recipes.",
        "NSCameraUsageDescription": "NutriFlow uses your camera so you can take a photo for your recipe.",
        "NSSpeechRecognitionUsageDescription": "Allow NutriFlow to use speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "Allow NutriFlow to use the microphone for voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000F26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nutriFlow",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.223613501486-am8iqmgfa2c8k2u0nqo497c7bpv0fscu"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow NutriFlow to access your step count to show your daily activity."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000F26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow NutriFlow to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow NutriFlow to use speech recognition for voice search."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "450c786e-2b28-415f-a36a-f5806e757935"
      }
    },
    "owner": "kristina_gyk"
  }
}
